# Local review demo: no Supabase connection is needed.
LOGOS_STORAGE_URL=http://127.0.0.1:8081/api/storage/v1
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
DEFAULT_TIMEZONE=Asia/Kolkata

# Optional: your own server-side Sarvam credential for voice processing.
# Leave empty to browse the synthetic dataset without provider calls.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=glm5.3
